# Copy to Railway → service → Variables. Never commit real values.

# One passcode per admin (10+ characters). The name in the middle is who signs in.
ADMIN_JACK_PASSWORD=
ADMIN_SEAN_PASSWORD=

# 32+ random characters; keeps admins signed in across restarts. `openssl rand -hex 32`
SESSION_SECRET=

# Railway Postgres: set to ${{Postgres.DATABASE_URL}} so the game survives restarts/redeploys.
DATABASE_URL=

# Optional: phase lengths in seconds (defaults: 180 / 180 / 60).
# SUBMIT_SECONDS=180
# VOTE_SECONDS=180
# SUPERLATIVE_SECONDS=60
